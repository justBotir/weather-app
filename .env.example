# ---------- apps/api ----------
DATABASE_URL="postgresql://weather:weather@localhost:5432/weather?schema=public"

# --- Weather provider ---
# Default provider is Open-Meteo: no key, no account, no card required.
# Override the endpoints only if you self-host or proxy them.
# OPEN_METEO_URL="https://api.open-meteo.com/v1/forecast"
# OPEN_METEO_GEOCODING_URL="https://geocoding-api.open-meteo.com/v1/search"
# NOMINATIM_URL="https://nominatim.openstreetmap.org/reverse"

# Nominatim's usage policy requires an identifiable User-Agent. Put a real
# contact address here before deploying anywhere public.
APP_USER_AGENT="weather-app/0.1 (dev)"

# Only needed if you rebind WEATHER_PROVIDER to OpenWeatherProvider in
# weather.module.ts. Server-only — NEVER prefix this with NEXT_PUBLIC_.
OPENWEATHER_API_KEY=""
OPENWEATHER_BASE_URL="https://api.openweathermap.org"

API_PORT=4000
WEB_ORIGIN="http://localhost:3000"

# Optional — omit to use the in-memory cache.
REDIS_URL=""

# ---------- apps/web ----------
# Private: used by Route Handlers on the server only.
API_BASE_URL="http://localhost:4000"
