{
  "name": "weather-app",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run start:dev -w @weather/api",
    "dev:web": "npm run dev -w @weather/web",
    "build": "npm run build --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @weather/api",
    "db:studio": "npm run db:studio -w @weather/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "kill:api": "powershell -NoProfile -Command \"Get-NetTCPConnection -LocalPort 4000 -State Listen -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique | ForEach-Object { Stop-Process -Id $_ -Force }\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
